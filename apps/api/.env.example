# SmartNutri API — copy to apps/api/.env (git-ignored) and fill in. NEVER commit real values.
ENVIRONMENT=dev
# Root log level: DEBUG, INFO, WARNING, ERROR or CRITICAL. Independent of ENVIRONMENT.
# DEBUG can log library detail (SQL, HTTP); use it locally only, never in staging/prod.
LOG_LEVEL=INFO

# --- CallMissed (AI + speech). SECRET. Server-side only. ---
CALLMISSED_API_KEY=
CALLMISSED_BASE_URL=https://api.callmissed.com/v1
CALLMISSED_RESOURCE_URL=https://api.callmissed.com/api/v1
# Model ids are config, not code (ADR 0021; docs/SETUP_ACCOUNTS.md "CallMissed AI setup").
# Every default is processed in India. Health-data calls (explanations, voice answers, STT,
# TTS) refuse any model outside app.integrations.callmissed.INDIA_PROCESSED_MODELS.
# gemma-4-31b, glm-5.3-flash, deepseek-v4.1-flash-1017, whisper and gnani-timbre-v3.0 need a
# paid plan (Starter or higher). No deprecated model (gpt-4o, sunset 2026-11-16) may be a
# default or a fallback; the allow-list refuses it (Ruling CM1).
# A *_FALLBACK_MODEL is tried once, inside the same deadline, on a 5xx, a timeout or a
# region_unavailable refusal. Leave it empty to turn the fallback off.
# Reasoning effort: none, minimal, low, medium, high or xhigh (empty = not sent).
#
# Label extraction (vision). The label eval compares gemma-4-31b, glm-5.3-flash and
# deepseek-v4.1-flash-1017 before the final choice.
CALLMISSED_EXTRACTION_MODEL=gemma-4-31b
CALLMISSED_EXTRACTION_FALLBACK_MODEL=glm-5.3-flash
CALLMISSED_EXTRACTION_REASONING_EFFORT=none
# Label-extraction prompt: extraction_v1 (default) or extraction_v2 (raw cells, parsed in
# code; stays off until the photo eval shows it is better).
EXTRACTION_PROMPT_VERSION=extraction_v1
# Explanations and voice answers (8 s budget). sarvam-105b is selectable but slower.
CALLMISSED_EXPLANATION_MODEL=gemma-4-31b
CALLMISSED_EXPLANATION_FALLBACK_MODEL=deepseek-v4.1-flash-1017
CALLMISSED_EXPLANATION_REASONING_EFFORT=none
# Speech-to-text. Language maps (JSON) send en/hi/mr as the `language` field; a language
# left out of a map is auto-detected. Whisper's codes are not documented, so its map is empty.
CALLMISSED_STT_MODEL=saaras:v4
CALLMISSED_STT_FALLBACK_MODEL=whisper
CALLMISSED_STT_LANGUAGES={"en": "en-IN", "hi": "hi-IN", "mr": "mr-IN"}
CALLMISSED_STT_FALLBACK_LANGUAGES={}
# Text-to-speech (mp3). One voice per language (JSON), from docs.callmissed.com/docs/tts-voices.
CALLMISSED_TTS_MODEL=bulbul:v3
CALLMISSED_TTS_VOICES={"en": "ratan", "hi": "shubh", "mr": "ratan"}
CALLMISSED_TTS_FALLBACK_MODEL=gnani-timbre-v3.0
CALLMISSED_TTS_FALLBACK_VOICES={"en": "Chetana", "hi": "Chetana", "mr": "Chetana"}
# packages/i18n/messages, read for spoken fallback answers. Default: the repo checkout.
# The Docker image sets /app/i18n. Leave unset locally.
# I18N_MESSAGES_DIR=

# --- Supabase (Mumbai) ---
SUPABASE_URL=https://uhjopvrewcwqvugmdhdw.supabase.co
SUPABASE_PROJECT_REF=uhjopvrewcwqvugmdhdw
SUPABASE_JWKS_URL=https://uhjopvrewcwqvugmdhdw.supabase.co/auth/v1/.well-known/jwks.json
# SECRET — service_role / secret key. Never in the apps.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=label-photos
# Voice questions (POST /v1/voice/ask). While false the route answers 503 ai_unavailable.
# Keep false on dev and prod until the user has approved the paid end-to-end probe
# (`uv run python -m scripts.probe_callmissed --yes-spend`). Voice audio is never stored:
# the spoken answer is returned inline (ADR 0020), so there is no voice bucket.
VOICE_ENABLED=false
# SECRET — Session pooler connection string (port 5432), with +psycopg driver:
# postgresql+psycopg://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# --- HTTP ---
ALLOWED_ORIGINS=http://localhost:3000

# --- Open Food Facts (required User-Agent) ---
OFF_USER_AGENT=SmartNutri/0.1 (contact: your-team-email@example.com)
OFF_BASE_URL=https://world.openfoodfacts.org
# How long a cached OFF product is fresh (hours). 168 = 7 days.
OFF_CACHE_TTL_HOURS=168
OFF_DATA_CONFIDENCE=0.9
# Open Food Facts search calls per minute for this whole process (OFF allows about 10).
# Over it, search serves the cache or answers 503 off_unavailable.
OFF_SEARCH_PER_MINUTE=8

# --- Limits & cost control ---
RATE_LIMIT_LABEL_SCANS_PER_DAY=30
RATE_LIMIT_VOICE_PER_DAY=20
RATE_LIMIT_REPORTS_PER_DAY=10
RATE_LIMIT_SCAN_UPLOADS_PER_DAY=60
RATE_LIMIT_LABEL_REQUESTS_PER_DAY=200
RATE_LIMIT_PRODUCT_CREATES_PER_DAY=50
RATE_LIMIT_ANALYZE_PER_HOUR=120
RATE_LIMIT_PUBLIC_PER_MINUTE=60
RATE_LIMIT_MEAL_LOGS_PER_DAY=300
RATE_LIMIT_SEARCH_PER_MINUTE=60
# Shared by barcode lookup, alternatives and compare (each may call Open Food Facts).
RATE_LIMIT_PRODUCT_LOOKUPS_PER_HOUR=300
# POST /v1/consents and DELETE /v1/me, per account per UTC day.
RATE_LIMIT_CONSENTS_PER_DAY=60
RATE_LIMIT_ACCOUNT_DELETES_PER_DAY=5
# POST /v1/members and PATCH /v1/members/{id} together, per account per UTC day.
RATE_LIMIT_MEMBER_WRITES_PER_DAY=60
# Trusted reverse proxies in front of the API; X-Forwarded-For entries are counted from the right.
# Local dev: 0 (use the socket peer). Behind an external Application Load Balancer the header is
# "<client-ip>,<lb-ip>" (documented in Cloud Load Balancing docs): use 2. Directly on a Cloud Run
# *.run.app URL Google's front end appends the client IP as the last entry: use 1 (not stated in the
# Cloud Run docs; verify with a real request before relying on it). Too-high values fall back to
# the socket peer.
TRUSTED_PROXY_HOPS=0

# --- Phone OTP: Supabase Send-SMS hook -> CallMissed WhatsApp (Plan 8 Task 5) ---
# Keep false until Meta approves the AUTHENTICATION template (Plan 8 Task 14). The clients have
# their own flags (FEATURE_PHONE_OTP / NEXT_PUBLIC_FEATURE_PHONE_OTP).
PHONE_OTP_ENABLED=false
# SECRET — "v1,whsec_..." from Supabase → Auth → Hooks → Send SMS.
SUPABASE_SEND_SMS_HOOK_SECRET=
CALLMISSED_WHATSAPP_OTP_TEMPLATE=smartnutri_otp
CALLMISSED_WHATSAPP_PHONE_NUMBER_ID=

# --- Observability (optional in dev) ---
SENTRY_DSN=
POSTHOG_API_KEY=

# Google OAuth (Web client, used by Supabase Google provider)
GOOGLE_WEB_CLIENT_ID=
# SECRET — paste into Supabase → Auth → Providers → Google; never used by app code
GOOGLE_WEB_CLIENT_SECRET=
