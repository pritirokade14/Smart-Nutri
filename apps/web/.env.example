# SmartNutri web — copy to apps/web/.env.local (git-ignored).
# Everything named NEXT_PUBLIC_* is shipped to every browser: NEVER put a secret in one.
# The CallMissed key does NOT belong here — only apps/api uses it.
NEXT_PUBLIC_SUPABASE_URL=https://uhjopvrewcwqvugmdhdw.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_FEATURE_PHONE_OTP=false
NEXT_PUBLIC_FEATURE_EMAIL_OTP=false
# Push-to-talk voice (F10). Code default false; dev sets it true via the GitHub repo variable of
# the same name (web build). Needs VOICE_ENABLED=true on the API.
NEXT_PUBLIC_FEATURE_VOICE=false

# Server-only (not exposed to the browser)
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
