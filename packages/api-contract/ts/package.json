{
  "name": "@smartnutri/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Generated SmartNutri API types plus a configured openapi-fetch client. Regenerate with `just contract`.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript ../openapi.json -o src/schema.d.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "~5.9.3"
  }
}
