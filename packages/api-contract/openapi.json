{
  "components": {
    "schemas": {
      "AnalyzeOut": {
        "properties": {
          "explanation": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Explanation"
          },
          "product": {
            "$ref": "#/components/schemas/ProductOut"
          },
          "report": {
            "additionalProperties": true,
            "title": "Report",
            "type": "object"
          },
          "scan_id": {
            "format": "uuid",
            "title": "Scan Id",
            "type": "string"
          },
          "tips": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Tips",
            "type": "array"
          },
          "verdicts": {
            "items": {
              "$ref": "#/components/schemas/VerdictOut"
            },
            "title": "Verdicts",
            "type": "array"
          }
        },
        "required": [
          "scan_id",
          "product",
          "report",
          "verdicts"
        ],
        "title": "AnalyzeOut",
        "type": "object"
      },
      "AnalyzeRequest": {
        "description": "Exactly one product reference: our own ``product_id``, or a ``barcode`` (OFF products\nhave no product_id). With no ``member_ids`` the account's primary member is used.",
        "properties": {
          "barcode": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Barcode"
          },
          "language": {
            "default": "en",
            "enum": [
              "en",
              "hi",
              "mr"
            ],
            "title": "Language",
            "type": "string"
          },
          "member_ids": {
            "anyOf": [
              {
                "items": {
                  "format": "uuid",
                  "type": "string"
                },
                "maxItems": 10,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Member Ids"
          },
          "product_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Product Id"
          }
        },
        "title": "AnalyzeRequest",
        "type": "object"
      },
      "ErrorBody": {
        "description": "A stable `code`; clients localise `message_key` (always `error.<code>`).",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "additionalProperties": true,
            "title": "Details",
            "type": "object"
          },
          "message_key": {
            "title": "Message Key",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message_key",
          "details"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorEnvelope": {
        "description": "The only error shape the API returns (never FastAPI's `{\"detail\": [...]}`).",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "HealthOut": {
        "description": "`ok`/`ok` (200); `degraded`/`error` when the database is unreachable (503);\n`unavailable`/`schema_behind` when its Alembic revision is not this build's head (503).",
        "properties": {
          "database": {
            "enum": [
              "ok",
              "error",
              "schema_behind"
            ],
            "title": "Database",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "degraded",
              "unavailable"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "database"
        ],
        "title": "HealthOut",
        "type": "object"
      },
      "MeOut": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "language": {
            "enum": [
              "en",
              "hi",
              "mr"
            ],
            "title": "Language",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "display_name",
          "language",
          "created_at"
        ],
        "title": "MeOut",
        "type": "object"
      },
      "NutrientsOut": {
        "properties": {
          "carbs_g": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Carbs G"
          },
          "energy_kcal": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Energy Kcal"
          },
          "fat_g": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fat G"
          },
          "fiber_g": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fiber G"
          },
          "protein_g": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Protein G"
          },
          "salt_g": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Salt G"
          },
          "sat_fat_g": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sat Fat G"
          },
          "sodium_mg": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sodium Mg"
          },
          "sugars_g": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sugars G"
          }
        },
        "required": [
          "energy_kcal",
          "protein_g",
          "carbs_g",
          "sugars_g",
          "fat_g",
          "sat_fat_g",
          "fiber_g",
          "salt_g",
          "sodium_mg"
        ],
        "title": "NutrientsOut",
        "type": "object"
      },
      "ProductCreate": {
        "description": "A product the user confirmed on the label-confirm screen, or typed by hand.\n\nWith ``scan_id`` the values come from that label scan's draft (source ``label``, the\ndraft's extraction confidence); without it the entry is manual (source ``user``,\nconfidence 1.0). Blank values are null, never 0. Text keeps its script (Devanagari stays\nDevanagari); only surrounding whitespace is trimmed and blank items are dropped.",
        "properties": {
          "allergen_statement": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Allergen Statement"
          },
          "barcode": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Barcode"
          },
          "brand": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Brand"
          },
          "category": {
            "default": "general",
            "enum": [
              "general",
              "beverage",
              "water",
              "cheese",
              "fat"
            ],
            "title": "Category",
            "type": "string"
          },
          "claims": {
            "default": [],
            "items": {
              "maxLength": 200,
              "type": "string"
            },
            "maxItems": 50,
            "title": "Claims",
            "type": "array"
          },
          "confirmed_fields": {
            "default": [],
            "items": {
              "enum": [
                "energy_kcal",
                "protein_g",
                "carbs_g",
                "sugars_g",
                "fat_g",
                "sat_fat_g",
                "fiber_g",
                "salt_g",
                "sodium_mg"
              ],
              "type": "string"
            },
            "maxItems": 9,
            "title": "Confirmed Fields",
            "type": "array"
          },
          "ingredients": {
            "default": [],
            "items": {
              "maxLength": 500,
              "type": "string"
            },
            "maxItems": 300,
            "title": "Ingredients",
            "type": "array"
          },
          "may_contain_statement": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "May Contain Statement"
          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "per_100g": {
            "$ref": "#/components/schemas/NutrientsOut"
          },
          "scan_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scan Id"
          },
          "serving_size_g": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Serving Size G"
          },
          "veg_mark": {
            "anyOf": [
              {
                "enum": [
                  "veg",
                  "non_veg"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Veg Mark"
          }
        },
        "required": [
          "name",
          "per_100g"
        ],
        "title": "ProductCreate",
        "type": "object"
      },
      "ProductOut": {
        "properties": {
          "attribution": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Attribution"
          },
          "barcode": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Barcode"
          },
          "brand": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Brand"
          },
          "category": {
            "title": "Category",
            "type": "string"
          },
          "claims": {
            "items": {
              "type": "string"
            },
            "title": "Claims",
            "type": "array"
          },
          "image_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Url"
          },
          "ingredients": {
            "items": {
              "type": "string"
            },
            "title": "Ingredients",
            "type": "array"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "per_100g": {
            "$ref": "#/components/schemas/NutrientsOut"
          },
          "product_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Product Id"
          },
          "serving_size_g": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Serving Size G"
          },
          "source": {
            "enum": [
              "smartnutri",
              "openfoodfacts"
            ],
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "source",
          "product_id",
          "barcode",
          "name",
          "brand",
          "image_url",
          "category",
          "per_100g",
          "serving_size_g",
          "ingredients",
          "claims",
          "attribution"
        ],
        "title": "ProductOut",
        "type": "object"
      },
      "PublicProductOut": {
        "properties": {
          "product": {
            "$ref": "#/components/schemas/ProductOut"
          },
          "report": {
            "additionalProperties": true,
            "title": "Report",
            "type": "object"
          },
          "score_label": {
            "const": "calculated_by_smartnutri",
            "title": "Score Label",
            "type": "string"
          }
        },
        "required": [
          "product",
          "report",
          "score_label"
        ],
        "title": "PublicProductOut",
        "type": "object"
      },
      "ReasonOut": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "params": {
            "additionalProperties": true,
            "title": "Params",
            "type": "object"
          },
          "severity": {
            "enum": [
              "ok",
              "caution",
              "unknown",
              "avoid"
            ],
            "title": "Severity",
            "type": "string"
          }
        },
        "required": [
          "code",
          "severity",
          "params"
        ],
        "title": "ReasonOut",
        "type": "object"
      },
      "VerdictOut": {
        "properties": {
          "member_id": {
            "format": "uuid",
            "title": "Member Id",
            "type": "string"
          },
          "member_name": {
            "title": "Member Name",
            "type": "string"
          },
          "profile_set_up": {
            "description": "False: age/allergies/diet may not be set; clients show a 'profile not set up' note. Display metadata only; never changes status or reasons.",
            "title": "Profile Set Up",
            "type": "boolean"
          },
          "reasons": {
            "items": {
              "$ref": "#/components/schemas/ReasonOut"
            },
            "title": "Reasons",
            "type": "array"
          },
          "status": {
            "enum": [
              "ok",
              "caution",
              "unknown",
              "avoid"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "member_id",
          "member_name",
          "status",
          "reasons",
          "profile_set_up"
        ],
        "title": "VerdictOut",
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "SmartNutri API",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/analyze": {
      "post": {
        "operationId": "analyze_create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalyzeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalyzeOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Missing or invalid access token"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Validation error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Rate limited"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Internal error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Open Food Facts unavailable"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Analyze Create",
        "tags": [
          "analyze"
        ]
      }
    },
